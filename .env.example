# Supabase (or any Postgres). Both are required.
#
# DATABASE_URL — transaction-mode pooler, port 6543. Used by the app at runtime.
#   ?pgbouncer=true is required: the pooler cannot hold Prisma's prepared
#   statements, and without it you get intermittent "prepared statement already
#   exists" errors under concurrent load.
#
# DIRECT_URL — session-mode pooler, port 5432. Used by migrations, which need
#   session state a transaction pooler will not keep.
#
# Find both under Connect → ORMs → Prisma in the Supabase dashboard.

DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
