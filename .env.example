# Supabase (or any Postgres). Both are required.
#
# Named APP_* to stay clearly distinct from the dozen POSTGRES_* and SUPABASE_*
# variables Vercel's Supabase integration injects, none of which this app reads.
#
# On Vercel, do not mark these "Sensitive" — sensitive values cannot be read back
# afterwards, so a mistyped connection string becomes impossible to diagnose.
#
# APP_DATABASE_URL — transaction-mode pooler, port 6543. Used at runtime.
#   ?pgbouncer=true is required: the pooler cannot hold Prisma's prepared
#   statements, and without it you get intermittent "prepared statement already
#   exists" errors under concurrent load.
#
# APP_DIRECT_URL — session-mode pooler, port 5432. Used by migrations, which
#   need session state a transaction pooler will not keep.
#
# Find both under Connect → ORMs → Prisma in the Supabase dashboard. The username
# must be the tenant-qualified `postgres.[ref]`, not a bare `postgres`.

APP_DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
APP_DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Optional automatic Google Sheets sync. All values are server-only.
# Share the spreadsheet with the service account email as a Viewer.
GOOGLE_SHEETS_ID=""
# Include the header row and all data rows. Quote tab names containing spaces.
GOOGLE_SHEETS_RANGE="'Applications'!A:Z"
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Paste private_key from the service-account JSON; literal \n is supported.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# Match TRACKER_WEBHOOK_SECRET in Apps Script's Script Properties.
GOOGLE_SHEETS_WEBHOOK_SECRET=""
