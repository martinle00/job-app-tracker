// Job application tracker schema.
//
// `furthestStage` and `outcome` are plain strings rather than database enums.
// Their permitted values live in src/lib/stages.ts and are enforced by the Zod
// schemas in src/lib/validation.ts, which every write path (form action and CSV
// importer) goes through. Keeping them as strings means the sheet's vocabulary
// can grow without a migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the app; migrations need a direct one, since a
  // transaction-mode pooler cannot hold the session state they require.
  //
  // Named APP_* rather than DATABASE_URL/DIRECT_URL to stay clearly distinct
  // from the dozen POSTGRES_* and SUPABASE_* variables Vercel's Supabase
  // integration injects, none of which this app reads. The username in both
  // must be the tenant-qualified `postgres.[ref]`; a bare `postgres` cannot
  // authenticate against the pooler.
  url       = env("APP_DATABASE_URL")
  directUrl = env("APP_DIRECT_URL")
}

model Person {
  id           String        @id @default(cuid())
  // Normalised key used for matching: lower-cased, whitespace-collapsed.
  name         String        @unique
  // What we actually show in the UI, preserving the original casing. Editable
  // in Settings: it is an alias, not an identity, so renaming must not fork the
  // person or break the import key.
  displayName  String
  // Dot colour shown beside this person in the table and the people filter.
  // Null falls back to a neutral, so an unset colour is not an error state.
  color        String?
  applications Application[]
}

model Application {
  id            String    @id @default(cuid())
  person        Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId      String
  company       String
  role          String
  source        String?
  location      String?
  workType      String?
  jobUrl        String?
  // Null for shortlisted roles that have not been applied to yet.
  appliedDate   DateTime?
  closingDate   DateTime?
  lastActivity  DateTime?
  furthestStage String
  outcome       String
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // One row per person/company/role, matching one row per role in the sheet.
  // Deliberately excludes appliedDate: a shortlisted row gains one when it is
  // actually sent, and re-importing must update that row rather than fork it.
  @@unique([personId, company, role], name: "importKey")
  @@index([personId])
  @@index([appliedDate])
}

/// Single-row-per-key store for tracker-wide preferences (currently the accent
/// colour). There are no accounts, so preferences are shared like the data is.
model Setting {
  key   String @id
  value String
}
