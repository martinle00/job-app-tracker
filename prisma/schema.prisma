// Job application tracker schema.
//
// `furthestStage` and `outcome` are plain strings because SQLite has no native
// enum support in Prisma. Their permitted values live in src/lib/stages.ts and
// are enforced by the Zod schemas in src/lib/validation.ts, which every write
// path (form action and CSV importer) goes through.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Person {
  id           String        @id @default(cuid())
  // Normalised key used for matching: lower-cased, whitespace-collapsed.
  name         String        @unique
  // What we actually show in the UI, preserving the original casing.
  displayName  String
  applications Application[]
}

model Application {
  id            String    @id @default(cuid())
  person        Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId      String
  company       String
  role          String
  source        String?
  location      String?
  workType      String?
  jobUrl        String?
  // Null for shortlisted roles that have not been applied to yet.
  appliedDate   DateTime?
  closingDate   DateTime?
  lastActivity  DateTime?
  furthestStage String
  outcome       String
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // One row per person/company/role, matching one row per role in the sheet.
  // Deliberately excludes appliedDate: a shortlisted row gains one when it is
  // actually sent, and re-importing must update that row rather than fork it.
  @@unique([personId, company, role], name: "importKey")
  @@index([personId])
  @@index([appliedDate])
}
